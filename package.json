{
  "name": "timeweb-mcp",
  "version": "0.1.8",
  "description": "MCP-сервер для управления инфраструктурой Timeweb Cloud",
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify",
    "start": "node -r dotenv/config dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector npm run start",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "type-check": "tsc --noEmit",
    "test:release": "node --test scripts/release-version.test.mjs",
    "test:openapi": "node --test scripts/openapi.test.mjs",
    "test:smoke-start": "node --test scripts/smoke-start.test.mjs",
    "test:transport": "node scripts/test-transport.mjs",
    "smoke": "node scripts/smoke-start.mjs && node scripts/smoke-mcp.mjs",
    "smoke:startup-series": "node scripts/smoke-start-series.mjs",
    "verify": "npm run validate:openapi && npm run test:openapi && npm run test:release && npm run test:smoke-start && npm run type-check && npm run test:transport && npm run build && npm run smoke",
    "normalize:openapi": "node scripts/normalize-openapi.mjs",
    "validate:openapi": "node scripts/validate-openapi.mjs"
  },
  "keywords": [
    "mcp",
    "timeweb",
    "timeweb-cloud",
    "cloud",
    "infrastructure",
    "model-context-protocol"
  ],
  "author": "ichinya",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "timeweb-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichinya/timeweb-mcp.git"
  },
  "homepage": "https://github.com/ichinya/timeweb-mcp#readme",
  "bugs": {
    "url": "https://github.com/ichinya/timeweb-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
