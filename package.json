{
  "name": "timeweb-mcp",
  "version": "0.1.6",
  "description": "MCP-сервер для управления инфраструктурой Timeweb Cloud",
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "prepublishOnly": "npm run validate:openapi && npm run type-check",
    "start": "node -r dotenv/config dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector npm run start",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "type-check": "tsc --noEmit",
    "normalize:openapi": "node scripts/normalize-openapi.mjs",
    "validate:openapi": "node scripts/validate-openapi.mjs"
  },
  "keywords": [
    "mcp",
    "timeweb",
    "timeweb-cloud",
    "cloud",
    "infrastructure",
    "model-context-protocol"
  ],
  "author": "ichinya",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "timeweb-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichinya/timeweb-mcp.git"
  },
  "homepage": "https://github.com/ichinya/timeweb-mcp#readme",
  "bugs": {
    "url": "https://github.com/ichinya/timeweb-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "axios": "^1.11.0",
    "dotenv": "^16.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsdown": "^0.13.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
